rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == '2AJSfYdtg5URWHv7HCzpNMmKIlg2';
    }

    match /families/{uid}/learners/{learnerId} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /progress/{progressId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read, create: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data == resource.data;
        allow delete: if false;
      }
    }

    // Openday reuses the same parent Firebase Authentication account as
    // Kk-syllabus. Public catalogue publishing is performed by an authorised
    // backend/service account; private browser state remains owner-only.
    match /app_private_state/openday {
      allow read: if isOwner('2AJSfYdtg5URWHv7HCzpNMmKIlg2');
      allow create, update: if isOwner('2AJSfYdtg5URWHv7HCzpNMmKIlg2')
        && request.resource.data.app == 'openday';
      allow delete: if false;
    }


    // Public Openday date/time reports.
    // Reports are append-only and publicly readable so every visitor sees the
    // same reported corrections. Personal visit notes stay in private state.
    match /openday_public_reports/{reportId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
          'app',
          'schoolId',
          'date',
          'startTime',
          'endTime',
          'contributorId',
          'contributorLabel',
          'status',
          'updatedAt'
        ])
        && request.resource.data.app == 'openday'
        && request.resource.data.status == 'reported'
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0
        && request.resource.data.schoolId.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 10
        && request.resource.data.startTime is string
        && request.resource.data.startTime.size() <= 5
        && request.resource.data.endTime is string
        && request.resource.data.endTime.size() <= 5
        && request.resource.data.contributorId is string
        && request.resource.data.contributorId.size() >= 8
        && request.resource.data.contributorId.size() <= 80
        && request.resource.data.contributorLabel is string
        && request.resource.data.contributorLabel.size() >= 3
        && request.resource.data.contributorLabel.size() <= 80
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }


    // Openday memorable-token capability.
    // The client derives an unguessable document ID from the memorable token.
    // Collection listing is forbidden. Only the owner can create/rotate a
    // capability; anyone who knows the exact active capability path can use
    // that token to sync Openday private state.
    match /openday_sync/{tokenHash} {
      function activeOpenDayToken() {
        return resource.data.app == 'openday'
          && resource.data.active == true
          && resource.data.ownerUid == '2AJSfYdtg5URWHv7HCzpNMmKIlg2'
          && resource.data.tokenHash == tokenHash;
      }

      allow get: if isOwner('2AJSfYdtg5URWHv7HCzpNMmKIlg2')
        || activeOpenDayToken();
      allow list: if false;

      allow create: if isOwner('2AJSfYdtg5URWHv7HCzpNMmKIlg2')
        && request.resource.data.app == 'openday'
        && request.resource.data.active == true
        && request.resource.data.ownerUid == '2AJSfYdtg5URWHv7HCzpNMmKIlg2'
        && request.resource.data.tokenHash == tokenHash;

      allow update: if isOwner('2AJSfYdtg5URWHv7HCzpNMmKIlg2')
        || (
          activeOpenDayToken()
          && request.resource.data.app == resource.data.app
          && request.resource.data.active == true
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.tokenHash == resource.data.tokenHash
        );

      allow delete: if false;
    }


    // Snag Recorder legacy archive.
    // Since the Snag app moved to its own Firebase project, kk-syllabus is a
    // read-only migration/rollback source. Existing authenticated users may
    // read only the Snag data they could access before migration; no Snag
    // client may create, update or delete legacy data.
    function snagSignedIn() {
      return request.auth != null;
    }

    function snagProject(projectId) {
      return get(/databases/$(database)/documents/snag_projects/$(projectId));
    }

    function snagMember(projectId) {
      return snagSignedIn()
        && exists(/databases/$(database)/documents/snag_projects/$(projectId)/members/$(request.auth.uid));
    }

    function snagMemberRole(projectId) {
      return get(/databases/$(database)/documents/snag_projects/$(projectId)/members/$(request.auth.uid)).data.role;
    }

    match /snag_projects/{projectId} {
      allow read: if snagSignedIn()
        && (resource.data.ownerUid == request.auth.uid || snagMember(projectId));
      allow create, update, delete: if false;

      match /members/{memberId} {
        allow read: if snagSignedIn()
          && (
            request.auth.uid == memberId
            || snagProject(projectId).data.ownerUid == request.auth.uid
            || snagMember(projectId)
          );
        allow create, update, delete: if false;
      }

      match /invites/{inviteId} {
        allow get: if snagSignedIn()
          && inviteId.matches('^[A-Za-z0-9_-]{32,120}$')
          && resource.data.active == true;
        allow list: if snagSignedIn()
          && snagProject(projectId).data.ownerUid == request.auth.uid;
        allow create, update, delete: if false;
      }

      match /snags/{snagId} {
        allow read: if snagSignedIn()
          && (snagProject(projectId).data.ownerUid == request.auth.uid || snagMember(projectId));
        allow create, update, delete: if false;

        match /updates/{updateId} {
          allow read: if snagSignedIn()
            && (snagProject(projectId).data.ownerUid == request.auth.uid || snagMember(projectId));
          allow create, update, delete: if false;
        }
      }

      match /members/{memberId}/seen/{snagId} {
        allow read: if snagSignedIn()
          && request.auth.uid == memberId
          && snagMember(projectId);
        allow create, update, delete: if false;
      }

      match /private_notes/{noteId} {
        function noteAdmin() {
          return snagProject(projectId).data.ownerUid == request.auth.uid
            || (snagMember(projectId) && snagMemberRole(projectId) == 'owner')
            || (snagMember(projectId)
              && get(/databases/$(database)/documents/snag_projects/$(projectId)/members/$(request.auth.uid)).data.admin == true);
        }
        // Read-only archive, with private notes still constrained by author.
        allow read: if snagSignedIn()
          && (noteAdmin() || resource.data.authorUid == request.auth.uid);
        allow create, update, delete: if false;
      }
    }

    // Sanitized developer-note feed for the retired shared-project Snag backend.
    match /snag_review_feeds/{feedId} {
      allow get: if feedId.matches('^[A-Za-z0-9_-]{40,120}$')
        && resource.data.app == 'snag';
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Beyond 100 persistent parent-controller capability.
    // A 256-bit random document ID is the bearer key. Exact-document reads are
    // permitted when the capability is active; collection listing is forbidden.
    // The bearer may update only command/presence fields. Creation, identity
    // changes and revocation remain restricted to the owner account.
    match /beyond100_parent_controllers/{controllerId} {
      function validControllerId() {
        return controllerId.matches('^[A-Za-z0-9_-]{43}$');
      }

      function validBearerCommand() {
        return request.resource.data.command == resource.data.command
          || (
            request.resource.data.command is map
            && request.resource.data.command.id is string
            && request.resource.data.command.action in [
              'set-phase',
              'set-outcome',
              'set-error',
              'set-prompt',
              'record',
              'next',
              'timer',
              'confidence',
              'parent-note',
              'request-state'
            ]
          );
      }

      function validBearerUpdate() {
        return validControllerId()
          && resource.data.app == 'beyond100'
          && resource.data.active == true
          && request.resource.data.app == resource.data.app
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.active == true
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.learnerId == resource.data.learnerId
          && request.resource.data.controllerVersion == resource.data.controllerVersion
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'command',
            'controllerPresence',
            'controllerUpdatedAt'
          ])
          && validBearerCommand();
      }

      allow get: if isOwner('2AJSfYdtg5URWHv7HCzpNMmKIlg2')
        || (
          validControllerId()
          && resource.data.app == 'beyond100'
          && resource.data.active == true
        );
      allow list: if false;

      allow create: if isOwner('2AJSfYdtg5URWHv7HCzpNMmKIlg2')
        && validControllerId()
        && request.resource.data.app == 'beyond100'
        && request.resource.data.kind == 'parent-controller-capability'
        && request.resource.data.active == true
        && request.resource.data.ownerUid == '2AJSfYdtg5URWHv7HCzpNMmKIlg2';

      allow update: if isOwner('2AJSfYdtg5URWHv7HCzpNMmKIlg2')
        || validBearerUpdate();

      allow delete: if false;
    }

    // Beyond 100 publishes only a sanitized review snapshot here.
    // The long random document ID acts as a bearer capability. Collection
    // listing is forbidden; only a caller who already knows the exact ID can get it.
    match /beyond100_review_feeds/{feedId} {
      allow get: if feedId.matches('^[A-Za-z0-9_-]{40,120}$')
        && resource.data.app == 'beyond100';
      allow list: if false;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == '2AJSfYdtg5URWHv7HCzpNMmKIlg2';
    }
  }
}
